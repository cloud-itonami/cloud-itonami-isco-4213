;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a collateral intake, appraisal-support and
;; vault-handling robot performs item photographing, tagging and secure vault
;; storage (ISCO 4213). Its physical work is lifting pledged items onto vault
;; shelving, and keeping the pledge records and small items in a fire-rated
;; container.
;;
;; The container case models one wall as a 1-D slab heated by a fire on its
;; outer face; contents and edges are not modelled.
;; Every number without a cited source is marked `estimate` in its :basis.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-4213"
 :cases
 [{:id :pledged-item-to-vault-shelf
   :kind :manipulator
   :procedure "arm lifts a tagged pledged item from the intake bench onto a vault shelf"
   :params {:l1-m 0.60 :l2-m 0.55 :m1-kg 8.0 :m2-kg 6.0
            :from [0.70 0.10] :to [0.30 0.80] :duration-s 3.0 :steps 600}
   :sweep {:param :payload-kg :values [0.5 2.0 5.0 10.0 15.0]}
   :quantity :peak-tau1-nm
   :limit {:max 150.0 :basis "estimate: continuous shoulder torque of a ~10 kg-class collaborative arm"}
   :boundary {:lo 0.1 :hi 40.0}}
  {:id :pledge-records-container-fire
   :kind :thermal
   :procedure "pledge tickets and records sit in an insulated container while a fire heats its outer wall for one hour"
   :params {:conductivity-w-mk 0.15 :density-kg-m3 900.0 :specific-heat-j-kgk 1000.0
            :t0-c 20.0 :t-hot-c 900.0 :h-front-w-m2k 40.0 :t-back-ambient-c 20.0 :h-back-w-m2k 5.0
            :threshold-c 177.0 :duration-s 3600.0}
   :sweep {:param :thickness-m :values [0.02 0.03 0.04 0.06 0.08]}
   :quantity :final-back-c
   :limit {:max 177.0 :basis "UL 72 Class 350 record protection: interior must stay at or below 350 F (177 C) during the rated exposure"}
   :boundary {:lo 0.005 :hi 0.20}}]}
